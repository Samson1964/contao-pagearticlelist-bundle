<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

<nav class="<?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>

<?php foreach ($this->pages as $page): ?>

<?php if ($this->hlPage): ?>
<<?= $this->hlPage ?> class="page_headline<?php if ($page['protected']): ?> protected<?php endif; ?>"><?= $page['title'] ?></<?= $this->hlPage ?>>
<?php endif; ?>

<ul>
<?php foreach ($page['articles'] as $article): ?>
	<li<?php if ($article['class']): ?> class="<?= $article['class'] ?>"<?php endif; ?>><?php if ($article['link']): ?><a href="<?= $article['link'] ?>"><?= $article['title'] ?></a><?php else: ?><span><?= $article['title'] ?></span><?php endif; ?>
<?php if ($article['teaser']): ?>
		<div<?php if ($article['teaser_cssID']): ?> id="<?= $article['teaser_cssID'] ?>"<?php endif; ?> class="teaser<?php if ($article['teaser_class']): ?> <?= $article['teaser_class'] ?><?php endif; ?>"><?= $article['teaser'] ?></div>
<?php endif; ?>
	</li>
<?php endforeach; ?>
</ul>

<?php endforeach; ?>

</nav>

<?php $this->endblock(); ?>
