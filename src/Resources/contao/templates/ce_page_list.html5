<?php $this->extend('block_searchable'); ?>

<?php $this->block('content'); ?>

<nav class="<?= $this->class ?> block"<?= $this->cssID ?><?php if ($this->style): ?> style="<?= $this->style ?>"<?php endif; ?>>

<?php if (!empty($this->pages)): ?>
<ul>
<?php foreach ($this->pages as $page): ?>
	<li class="<?= $page['class'] ?>"><?php if ($page['link']): ?><a href="<?= $page['link'] ?>" title="<?= $page['name'] ?>"><?= $page['title'] ?></a><?php else: ?><span><?= $page['title'] ?></span><?php endif; ?></li>
<?php endforeach; ?>
</ul>
<?php endif; ?>

</nav>

<?php $this->endblock(); ?>
