{
    "name": "schachbulle/contao-pagearticlelist-bundle",
    "type": "contao-bundle",
    "description": "Inhaltselemente für Seiten- und Artikellisten. Fork von srhinow/ce_article_list, das ab Contao 4.9 nicht mehr lief.",
    "keywords": [
        "contao",
        "artikel",
        "seiten",
        "liste"
    ],
    "homepage": "https://github.com/Samson1964/contao-pagearticlelist-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.0 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0",
        "symfony/routing": "^5.4 || ^6.0 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoPagearticlelistBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoPagearticlelistBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-pagearticlelist-bundle/issues",
        "source": "https://github.com/Samson1964/contao-pagearticlelist-bundle"
    }
}
